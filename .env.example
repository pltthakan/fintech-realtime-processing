# Copy this file to .env and replace every *_PASSWORD and JWT_SECRET value.
# Never commit .env. Values containing URL-reserved characters must be percent-encoded in MONGO_URI.

POSTGRES_DB=fintech_db
POSTGRES_USER=fintech_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

MONGO_USER=fintech_mongo
MONGO_PASSWORD=replace-with-a-strong-mongodb-password
MONGO_DB=fintech_transactions
MONGO_URI=mongodb://fintech_mongo:replace-with-url-encoded-mongodb-password@mongodb:27017/fintech_transactions?authSource=admin

REDIS_PASSWORD=replace-with-a-strong-redis-password
RABBITMQ_USER=fintech_rabbit
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
RABBITMQ_VHOST=fintech_vhost

EUREKA_USER=eureka
EUREKA_PASSWORD=replace-with-a-strong-eureka-password
JWT_SECRET=replace-with-a-long-random-jwt-secret

# Host ports are bound to 127.0.0.1 by default. Override only when remote access is intentional.
POSTGRES_HOST_PORT=5434
API_GATEWAY_HOST_PORT=8087
KAFKA_CONNECT_HOST_PORT=8088
FRONTEND_HOST_PORT=3001
